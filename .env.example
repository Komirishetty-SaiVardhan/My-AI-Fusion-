# ==============================================================================
# My AI — Server-Side Environment Template
# ==============================================================================
# Primary AI Provider
AI_PROVIDER=gemini

# Google Gemini API Key (Get your free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gemini Model Selection (e.g. gemini-flash-latest, gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-flash-latest
DEFAULT_AI_MODEL=gemini-flash-latest

# Streaming Timeout (in milliseconds)
AI_STREAMING_TIMEOUT_MS=60000

# ==============================================================================
# Clerk Authentication Configuration
# (Get your free API keys at https://dashboard.clerk.com)
# ==============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URL redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

